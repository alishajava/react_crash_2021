# Browser-facing origin of the React app (SP callback = $APP_URL/saml/acs)
APP_URL=http://localhost:3000
SAML_ENTRY_POINT=https://idp.example.com/sso/saml
# IdP signing certificate (base64, no PEM header/footer)
SAML_IDP_CERT=
# Optional; defaults to $APP_URL/saml/metadata
SAML_ISSUER=
SESSION_SECRET=change-me

# --- HR info (optional) ---
# SAML attribute names carrying HR fields (JSON; defaults shown)
# SAML_ATTR_MAP={"employeeId":"employeeNumber","department":"department","title":"title","manager":"manager","groups":"memberOf"}
# NAC REST API lookup; {id} = employee number if sent by IdP, else email. NAC values override SAML.
# NAC_API_URL=https://nac.corp.example/api/users/{id}
# NAC_API_TOKEN=            # Bearer, or use NAC_API_USER / NAC_API_PASSWORD for Basic
# NAC_RESPONSE_ROOT=        # dot path to the user object in the JSON response
# NAC_FIELD_MAP={"employeeId":"employeeId","department":"department","title":"title","manager":"manager","groups":"groups"}
# NAC_TIMEOUT_MS=5000
# Private CA for the NAC host: export NODE_EXTRA_CA_CERTS=/path/ca.pem

# --- Cisco ISE preset (ERS API) ---
# NAC_PRESET=cisco-ise
# NAC_BASE_URL=https://ise.corp.example:9060
# NAC_API_USER=ers-readonly           # ISE "ERS Operator" (read-only) admin account
# NAC_API_PASSWORD=
# NAC_LOOKUP_KEY=email                # auto | email | nameID  (value used as the ISE user name)
# NAC_STRIP_DOMAIN=true               # jdoe@corp.com -> jdoe
# NAC_GROUP_MAP={"<identity-group-guid>":"Employees"}
# export NODE_EXTRA_CA_CERTS=/path/to/ise-ca.pem   # ISE usually has a private/self-signed cert
