# Browser-facing origin of the React app (SP callback = $APP_URL/saml/acs)
APP_URL=http://localhost:3000
SAML_ENTRY_POINT=https://idp.example.com/sso/saml
# IdP signing certificate (base64, no PEM header/footer)
SAML_IDP_CERT=
# Optional; defaults to $APP_URL/saml/metadata
SAML_ISSUER=
SESSION_SECRET=change-me
